; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Frutiger Scape"
config/description="Third person shotter with VRM anime characters and bot terror."
config/version="0.1.0"
config/tags=PackedStringArray("engine", "visualnovel")
run/main_scene="res://samples/shooter_demo/scenes/shooter_arena.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.1882353, 0.20392157, 0.27450982, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://d2bbfkl2ymk7"
config/icon="uid://bklxfuuu03836"

[autoload]

SceneLoader="*res://visual-novel/scripts/globals/scene_loader.gd"
CinematicManager="res://visual-novel/scripts/globals/cinematic_manager.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"
SignalLens="*uid://85rkx60vm7a7"
Dialogic="*uid://cmk30nxiyick4"

[dialogic]

directories/dch_directory={
"Celia": "res://dialogic/characters/Celia.dch",
"Dani": "res://dialogic/characters/Dani.dch",
"Gael": "res://dialogic/characters/Gael.dch",
"Georgino": "res://dialogic/characters/Georgino.dch",
"Gerardo": "res://dialogic/characters/Gerardo.dch",
"Natalia": "res://dialogic/characters/Natalia.dch",
"Samuel": "res://dialogic/characters/Samuel.dch",
"archlinux-chan": "res://dialogic/characters/archlinux-chan.dch",
"brayan-metro": "res://dialogic/characters/brayan-metro.dch",
"dancer-metro": "res://dialogic/characters/dancer-metro.dch",
"devs-metro": "res://dialogic/characters/devs-metro.dch",
"jaime": "res://dialogic/characters/jaime.dch"
}
directories/dtl_directory={
"brayan-metro_metro": "res://dialogic/characters/brayan-metro_metro.dtl",
"dancer-metro_metro": "res://dialogic/timelines/dancer-metro_metro.dtl",
"metro_cinematica": "res://dialogic/timelines/metro_cinematica.dtl",
"presentation": "res://dialogic/timelines/presentation.dtl",
"teatro_cinematica01": "res://dialogic/timelines/teatro_cinematica01.dtl",
"welcome": "res://dialogic/timelines/welcome.dtl"
}
glossary/default_case_sensitive=true
layout/style_list=["res://dialogic/styles/my_new_style.tres"]
layout/default_style="res://dialogic/styles/my_new_style.tres"
variables={
"metro_talk_with_samuel": false,
"theatre_talk_with_celia": false,
"welcome_monologue": false
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}

[editor_plugins]

enabled=PackedStringArray("res://addons/FileAccessWeb/plugin.cfg", "res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/asset_placer/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/orbit_camera/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/plenticons/plugin.cfg", "res://addons/signal_lens/plugin.cfg", "res://addons/timchi_maze_generation/plugin.cfg", "res://addons/vrm/plugin.cfg")

[global_group]

ControllableCharacter="Controllable Characters that use ActionContainer"
CinematicCameras=""

